<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.startup">
      <startup class="com.example.annogpt.test.StartupHandler"/>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
   	  <initializer class="com.example.annogpt.test.preferences.PreferenceInitializer"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
         id="com.example.annogpt.test.preferences.AnnoGptPreferencePage"
         name="AnnoGPT Settings"
         class="com.example.annogpt.test.preferences.AnnoGptPreferencePage">
      </page>
   </extension>
   <extension point="org.eclipse.ui.commands">
	   <command 
	         id="com.example.annogpt.test.commands.toggle" 
	         name="Toggle AnnoGPT">
	      <state
	            class="org.eclipse.ui.handlers.RegistryToggleState:false"
	            id="org.eclipse.ui.commands.toggleState">
	      </state>
	   </command>
	</extension>
	
	<extension point="org.eclipse.ui.handlers">
	   <handler class="com.example.annogpt.test.handlers.ToggleHandler" commandId="com.example.annogpt.test.commands.toggle"/>
	</extension>
	
	<extension point="org.eclipse.ui.menus">
	   <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar">
	      <toolbar id="com.example.annogpt.test.toolbar">
	         <command commandId="com.example.annogpt.test.commands.toggle" 
	                  label="AnnoGPT On/Off" 
	                  style="toggle"/>
	      </toolbar>
	   </menuContribution>
	</extension>
</plugin>